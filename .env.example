# Copy to .env.local (gitignored) and fill in. For local development against
# `npx supabase start`, see supabase/README.md — the values it prints are the
# same for every local Supabase project, so that file just states them
# directly rather than making you copy them from CLI output each time.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
