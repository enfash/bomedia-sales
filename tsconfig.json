{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Explicit, because TS does not auto-include node_modules/@types here and
    // the test files need Jest's globals (describe/it/expect) to typecheck.
    "types": [
      "jest",
      "node",
      "react"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Deno Edge Functions — a separate runtime with its own globals (Deno.*)
  // and npm:/jsr: specifiers this project's Node/RN tsconfig can't resolve.
  // Typechecked separately, by Deno itself (`supabase functions serve` and
  // the hosted deploy both do this on their own).
  "exclude": [
    "supabase/functions/**"
  ]
}
